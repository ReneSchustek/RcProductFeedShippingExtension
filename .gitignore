# ============================================================
# .gitignore – RcProductFeedShippingExtension (Shopware 6 Plugin)
# ============================================================

# ============================================================
# PHP / Composer
# ============================================================
/vendor/
*.phar

# ============================================================
# Shopware Plugin Build
# ============================================================
*.zip
/node_modules/
/public/
/.pnpm-store/

# ============================================================
# Shopware Cache / Runtime
# ============================================================
/var/
/var/cache/
/var/log/

# ============================================================
# Secrets / Umgebung (NIEMALS in Git!)
# ============================================================
.env
.env.local
.env.*.local
!.env.example
*.secret
config/packages/secrets/

# ============================================================
# Test-Ergebnisse
# ============================================================
.phpunit.result.cache
/coverage/
/report/

# ============================================================
# IDE & Betriebssystem
# ============================================================
.idea/
.vscode/
*.DS_Store
Thumbs.db
desktop.ini
.phpstorm.meta.php
_ide_helper.php

# ============================================================
# Logs
# ============================================================
*.log
/logs/


# composer.lock — Library-Plugin: Versionen löst das Zielprojekt auf
composer.lock

# Die Ausnahmeliste des Spurenprüfers gehört ins Repository.
#
# Die globale Ausschlussliste filtert `.ai-trace-ignore` — gedacht war die Kopie, die
# früher in jedem Projekt lag. Sie versteckt aber auch diese eine, die der Prüfer
# tatsächlich liest. Der Fehler fällt nicht auf: Er liest sie aus dem
# Arbeitsverzeichnis, meldet sauber, und man hält die Ausnahme für eingetragen —
# während jeder Klon und jeder Lauf im Fließband ohne sie dasteht. Am 2026-09-07 traf
# das 17 von 22 Erweiterungen.
!.ai-trace-ignore

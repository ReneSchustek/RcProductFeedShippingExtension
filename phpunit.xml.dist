<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="tests/TestBootstrap.php"
         colors="true">
    <testsuites>
        <!-- Kleingeschrieben belassen: der Gate-Lauf ruft diese Suite namentlich auf. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!-- PHPUnit 11 erwartet den Abdeckungs-Filter unter <source>; der alte
         <coverage>-Block wird stillschweigend ignoriert. -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!-- Migrationen laufen einmal gegen ein echtes Schema; ein Unit-Test darüber
                 prüfte nur, dass SQL-Text gleich SQL-Text ist. -->
            <directory>src/Migration</directory>
            <directory>src/Resources</directory>
        </exclude>
    </source>
</phpunit>
